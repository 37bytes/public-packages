{
    "name": "@37bytes/units-helper",
    "version": "2.0.0",
    "description": "A package for easier usage and conversion of different units",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/37bytes/public-packages.git",
        "directory": "packages/units-helper"
    },
    "license": "ISC",
    "author": "Ruslan Ispaev",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.mts",
                "default": "./build/index.mjs"
            },
            "require": {
                "types": "./build/index.d.cts",
                "default": "./build/index.cjs"
            }
        }
    },
    "main": "./build/index.cjs",
    "module": "./build/index.mjs",
    "types": "./build/index.d.mts",
    "files": [
        "build",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "lint:typescript": "tsc --noEmit",
        "lint:eslint": "eslint --fix --max-warnings 0 .",
        "lint": "pnpm lint:typescript && pnpm lint:eslint",
        "npm-packlist": "pnpm run build && npx -y npm-packlist@6.0.1"
    },
    "keywords": [
        "units",
        "size",
        "time"
    ],
    "devDependencies": {
        "@37bytes/bundler": "workspace:*",
        "@37bytes/code-style": "workspace:*",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
