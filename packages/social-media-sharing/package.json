{
    "name": "@37bytes/social-media-sharing",
    "version": "1.0.1",
    "description": "Sharing functions for VK and WhatsApp, with which the 'react-share' package has some problems",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/37bytes/public-packages.git",
        "directory": "packages/social-media-sharing"
    },
    "license": "MIT",
    "author": "Arhonist",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.mts",
                "default": "./build/index.mjs"
            },
            "require": {
                "types": "./build/index.d.cts",
                "default": "./build/index.cjs"
            }
        }
    },
    "main": "./build/index.cjs",
    "module": "./build/index.mjs",
    "types": "./build/index.d.mts",
    "files": [
        "build",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "lint:typescript": "tsc --noEmit",
        "lint:eslint": "eslint --fix --max-warnings 0 .",
        "lint": "pnpm lint:typescript && pnpm lint:eslint",
        "npm-packlist": "pnpm run build && npx -y npm-packlist@6.0.1"
    },
    "keywords": [
        "vk",
        "vkontakte",
        "whatsApp",
        "sharing",
        "social media",
        "new tab"
    ],
    "devDependencies": {
        "@37bytes/bundler": "workspace:*",
        "@37bytes/code-style": "workspace:*",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "homepage": "https://github.com/37bytes/public-packages/tree/master/packages/social-media-sharing",
    "bugs": {
        "url": "https://github.com/37bytes/public-packages/issues"
    }
}
