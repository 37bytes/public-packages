{
    "name": "@37bytes/logstory",
    "version": "2.1.0",
    "description": "Logstory is a flexible and extensible logger for JavaScript that allows easy integration of additional features and sending events to monitoring systems such as Sentry or Graylog.",
    "license": "MIT",
    "author": "37bytes",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/37bytes/public-packages.git",
        "directory": "packages/logstory"
    },
    "keywords": [
        "logger"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.mts",
                "default": "./build/index.mjs"
            },
            "require": {
                "types": "./build/index.d.cts",
                "default": "./build/index.cjs"
            }
        }
    },
    "main": "./build/index.cjs",
    "module": "./build/index.mjs",
    "types": "./build/index.d.mts",
    "files": [
        "build",
        "README.md",
        "README_RU.md"
    ],
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "lint:typescript": "tsc --noEmit",
        "lint:eslint": "eslint --fix --max-warnings 0 .",
        "lint": "pnpm lint:typescript && pnpm lint:eslint"
    },
    "devDependencies": {
        "@37bytes/bundler": "workspace:*",
        "@37bytes/code-style": "workspace:*",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
