{
    "name": "@37bytes/configurable-media-context",
    "version": "3.0.0",
    "description": "A React context provider for managing media queries, allowing dynamic updates based on screen size.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/37bytes/public-packages.git",
        "directory": "packages/configurable-media-context"
    },
    "license": "MIT",
    "author": "37bytes",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./build/index.d.mts",
                "default": "./build/index.mjs"
            },
            "require": {
                "types": "./build/index.d.cts",
                "default": "./build/index.cjs"
            }
        }
    },
    "main": "./build/index.cjs",
    "module": "./build/index.mjs",
    "types": "./build/index.d.mts",
    "files": [
        "build",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "lint:typescript": "tsc --noEmit",
        "lint:eslint": "eslint --fix --max-warnings 0 .",
        "lint": "pnpm lint:typescript && pnpm lint:eslint",
        "npm-packlist": "pnpm run build && npx -y npm-packlist@6.0.1"
    },
    "keywords": [
        "react",
        "media-queries",
        "responsive",
        "context",
        "provider",
        "typescript",
        "react-context",
        "responsive-design"
    ],
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@37bytes/bundler": "workspace:*",
        "@37bytes/code-style": "workspace:*",
        "@types/react": "19.2.14",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "homepage": "https://github.com/37bytes/public-packages/tree/master/packages/configurable-media-context",
    "bugs": {
        "url": "https://github.com/37bytes/public-packages/issues"
    }
}
