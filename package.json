{
    "name": "public-packages",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.30.3",
    "scripts": {
        "prepare": "node .gitHooks/setupGitHooks.mjs",
        "lint-staged": "lint-staged",
        "build": "pnpm --filter './packages/*' --filter './core/*' -r run build",
        "test": "pnpm --filter './packages/*' --filter './core/*' -r run test",
        "lint:typescript:packages": "pnpm --filter './packages/*' -r run lint:typescript",
        "lint:typescript:core": "pnpm --filter './core/*' -r run lint:typescript",
        "lint:typescript": "pnpm lint:typescript:packages && pnpm lint:typescript:core",
        "lint:eslint:root": "eslint --fix --max-warnings 0 .",
        "lint:eslint:packages": "pnpm --filter './packages/*' -r run lint:eslint",
        "lint:eslint:core": "pnpm --filter './core/*' -r run lint:eslint",
        "lint:eslint": "pnpm lint:eslint:root && pnpm lint:eslint:packages && pnpm lint:eslint:core",
        "lint": "pnpm lint:typescript && pnpm lint:eslint"
    },
    "prettier": "@37bytes/code-style/prettier",
    "devDependencies": {
        "@37bytes/code-style": "workspace:*",
        "@babel/plugin-proposal-private-property-in-object": "7.21.11",
        "eslint": "catalog:",
        "lint-staged": "16.2.7",
        "prettier": "3.8.1"
    }
}
